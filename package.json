{
  "name": "leetbox",
  "private": true,
  "workspaces": [
    "server"
  ],
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "scripts": {
    "env": "cp -n .env.example .env; true",
    "up": "docker compose up -d --wait",
    "down": "docker compose down",
    "nuke": "docker compose down -v",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run seed -w server",
    "init": "npm run env && npm run up && npm install && npm run db:migrate && npm run db:seed",
    "reset": "npm run nuke && npm run init",
    "dev": "npm run dev -w server"
  }
}
